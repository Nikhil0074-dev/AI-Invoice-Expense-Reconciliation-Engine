# Copy to .env and change SECRET_KEY. Never commit the real file.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg2://invoice:invoice@db:5432/invoice
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=15
MAX_PAGES=20
OCR_PROVIDER=tesseract
# Tesseract language packs, e.g. eng+deu+fra+spa (packs must be installed in the image)
OCR_LANGUAGES=eng+deu+fra+spa
OCR_TIMEOUT_SECONDS=60
# inline | background | celery
PROCESSING_MODE=background
CELERY_BROKER_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
POSTGRES_USER=invoice
POSTGRES_PASSWORD=invoice
POSTGRES_DB=invoice
